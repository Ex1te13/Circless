# Токен бота от @BotFather
BOT_TOKEN=

# Твой Telegram id (можно несколько через запятую). Пусто = бот открыт всем.
ALLOWED_USERS=

# Supabase → кнопка Connect → «Transaction pooler» (порт 6543), вместо [YOUR-PASSWORD] — пароль базы
DATABASE_URL=

# Supabase → Project Settings → Data API (Project URL) и API Keys (service_role / secret)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Адрес проекта на Vercel, например https://<твой-проект>.vercel.app
PUBLIC_URL=

# Создаются командой:  .venv/bin/python deploy_setup.py secrets
WEBHOOK_SECRET=
CRON_SECRET=
